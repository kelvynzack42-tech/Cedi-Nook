# Local development (without DATABASE_URL, the app uses a local JSON fallback).
NODE_ENV=development
PORT=3000
APP_ORIGIN=http://localhost:3000
# PostgreSQL connection string. Set this for persistent cloud accounts and sync.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
# Required for PostgreSQL cloud sync. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# DATA_ENCRYPTION_KEY=put_generated_base64_key_here
# Optional: set PGSSLMODE=disable only for a local PostgreSQL server.
# PGSSLMODE=disable
PGPOOL_MAX=5


